# 统一换行符，避免 Windows 上提交出 CRLF 导致 diff 噪音
* text=auto eol=lf

# Windows 批处理必须是 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell 脚本必须是 LF，否则在 Linux/macOS 上无法执行
*.sh text eol=lf

# 二进制资源不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
